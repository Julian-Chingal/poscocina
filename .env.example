# ==============================================================================
# Poscocina - Configuración de Variables de Entorno (Docker / Dokploy / Local)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production

# ------------------------------------------------------------------------------
# Puerto de Exposición del Frontend (Host VPS)
# Ajusta CLIENT_PORT al puerto libre en tu servidor (ej. 80, 3005, 8080, etc.)
# El Backend (API) se comunica internamente y no necesita exponer puertos al host.
# ------------------------------------------------------------------------------
CLIENT_PORT=8080

# URL de la API consumida por la SPA (en producción con Nginx dejar /api como proxy interno)
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_USER=posuser
DB_PASSWORD=pospassword_seguro_produccion_2026
DB_NAME=poscocina
DB_PORT=5432

# URL de conexión construida para el contenedor o desarrollo local:
DATABASE_URL=postgresql://posuser:pospassword_seguro_produccion_2026@postgres:5432/poscocina

# ------------------------------------------------------------------------------
# Caché y Sockets PubSub (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Seguridad y Autenticación
# IMPORTANTE: JWT_SECRET debe tener al menos 32 caracteres criptográficos aleatorios
# ------------------------------------------------------------------------------
JWT_SECRET=poscocina_super_secret_production_key_32_chars_2026!
JWT_EXPIRES_IN=12h

# CORS (Orígenes permitidos separados por comas, o * si Nginx actúa como reverse proxy único)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Automatización de Migraciones y Semillas en Arranque del Servidor
# ------------------------------------------------------------------------------
RUN_MIGRATIONS=true
RUN_SEED=false

# Credenciales del Administrador Único Inicial (usadas solo si RUN_SEED=true)
ADMIN_EMAIL=admin@poscocina.com
ADMIN_PASSWORD=admin123
ADMIN_PIN=1234
