# ==============================================================================
# Poscocina - Configuración de Variables de Entorno (Docker / Dokploy / Local)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development

# ------------------------------------------------------------------------------
# Puertos para Desarrollo y Docker (Aislamiento y Convivencia con Producción)
# En desarrollo con Docker los servicios quedan expuestos en estos puertos
# alternativos en el host para convivir con producción o servicios locales sin choques:
# - DEV_PORT (host): 3001 -> contenedor Fastify (3000)
# - DEV_DB_PORT (host): 5433 -> contenedor PostgreSQL (5432)
# - DEV_VALKEY_PORT (host): 6380 -> contenedor Valkey (6379)
# - DEV_CLIENT_PORT (host): 5173 -> contenedor Vite Dev (5173)
# - CLIENT_PORT (host): 8080 -> contenedor Web Nginx en producción (80)
# ------------------------------------------------------------------------------
DEV_PORT=3001
DEV_DB_PORT=5433
DEV_VALKEY_PORT=6380
DEV_CLIENT_PORT=5173
CLIENT_PORT=8080

# ------------------------------------------------------------------------------
# Puerto de Exposición del Servidor Backend (Fastify) en Local / Producción
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# URL de la API consumida por el cliente Vite en desarrollo local
# Vite usará su proxy interno en localhost:5173 -> localhost:3000
# ------------------------------------------------------------------------------
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_USER=posuser
DB_PASSWORD=pospassword_seguro_produccion_2026
DB_NAME=poscocina
DB_PORT=5432

# URL de conexión para scripts ejecutados en tu máquina host (pnpm db:seed, pnpm db:migrate, etc.):
DATABASE_URL=postgresql://posuser:pospassword_seguro_produccion_2026@localhost:5432/poscocina

# ------------------------------------------------------------------------------
# Caché y Sockets PubSub (Valkey 8 / Compatible con Redis 7)
# ------------------------------------------------------------------------------
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
# Variables de compatibilidad hacia atrás:
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Seguridad y Autenticación
# IMPORTANTE: JWT_SECRET debe tener al menos 32 caracteres criptográficos aleatorios
# ------------------------------------------------------------------------------
JWT_SECRET=poscocina_super_secret_production_key_32_chars_2026!
JWT_EXPIRES_IN=12h

# CORS (Orígenes permitidos para Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ------------------------------------------------------------------------------
# Automatización de Migraciones y Semillas en Arranque del Servidor
# ------------------------------------------------------------------------------
RUN_MIGRATIONS=true
RUN_SEED=false

# Credenciales del Administrador Único Inicial (usadas solo si RUN_SEED=true)
ADMIN_EMAIL=admin@poscocina.com
ADMIN_PASSWORD=admin123
ADMIN_PIN=1234

# ------------------------------------------------------------------------------
# Almacenamiento de Multimedia (Imágenes y Modelos 3D)
# Compatible con S3 / MinIO / Garage / Filestash / Almacenamiento Local
# ------------------------------------------------------------------------------
# Ruta configurable para almacenamiento:
# Ejemplo imagen Filestash: catastrocol-cargues > gastropos
STORAGE_BUCKET=catastrocol-cargues
STORAGE_PATH=gastropos

# Conexión S3 / Garage / MinIO (si GARAGE_ACCESS_KEY_ID está vacío, guarda en ./uploads local)
GARAGE_S3_ENDPOINT=http://garage:3900
GARAGE_S3_REGION=garage
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# URL pública o CDN para servir archivos subidos (opcional)
# Ej: https://archivos.tudominio.com o https://s3.tudominio.com/catastrocol-cargues
PUBLIC_STORAGE_URL=

