# Server Environment Variables
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DB_USER=posuser
DB_PASSWORD=pospassword
DB_NAME=poscocina
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://posuser:pospassword@localhost:5432/poscocina

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Security
JWT_SECRET=super-secret-poscocina-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=12h

# Client / CORS
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
