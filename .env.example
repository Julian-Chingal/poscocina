# Poscocina Environment Variables Configuration (DEV / PROD)

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://posuser:pospassword@localhost:5432/poscocina

# Cache & Real-Time PubSub (Redis 7)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=poscocina_jwt_dev_enterprise_secure_token_key_2026
JWT_EXPIRES_IN=12h

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
