# syntax=docker/dockerfile:1
FROM node:22-alpine

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.4.1 --activate

# Copiar manifiestos de dependencias
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/tsconfig/base.json ./packages/tsconfig/
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/

# Instalar dependencias en el contenedor
RUN pnpm install --frozen-lockfile

# Copiar código fuente
COPY packages/tsconfig/ ./packages/tsconfig/
COPY packages/shared/ ./packages/shared/
COPY apps/server/ ./apps/server/

# Compilar paquete compartido base
RUN pnpm --filter @poscocina/shared build

# Copiar script de entrypoint dev
COPY apps/server/docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.dev.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.dev.sh && chmod +x /usr/local/bin/docker-entrypoint.dev.sh

# Crear directorio de uploads
RUN mkdir -p /app/uploads

EXPOSE 3000

ENV PORT=3000 \
    HOST=0.0.0.0 \
    NODE_ENV=development

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.dev.sh"]
CMD ["pnpm", "--filter", "@poscocina/server", "dev"]
